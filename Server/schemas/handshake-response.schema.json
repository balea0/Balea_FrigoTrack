{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Risposta handshake",
    "type": "object",
    "required": [
        "session_id",
        "B"
    ],
    "properties": {
        "session_id": {
            "type": "string",
            "format": "uuid"
        },
        "B": {
            "type": "string",
            "pattern": "^[0-9]+$"
        }
    },
    "additionalProperties": false
}

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Richiesta handshake",
    "type": "object",
    "required": [
        "p",
        "g",
        "A"
    ],
    "properties": {
        "p": {
            "type": "string",
            "pattern": "^[0-9]+$"
        },
        "g": {
            "type": "string",
            "pattern": "^[0-9]+$"
        },
        "A": {
            "type": "string",
            "pattern": "^[0-9]+$"
        }
    },
    "additionalProperties": false
}
